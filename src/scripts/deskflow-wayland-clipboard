#!/usr/bin/env bash
set -euo pipefail

# Enable Deskflow's Wayland clipboard backend when Deskflow is installed.
# Deskflow's wlClipboard option defaults to false; without it, copy/paste can
# fail on Wayland even when clipboard sharing is enabled. The wl-clipboard
# package is installed alongside Deskflow from netinstall.yaml.

user="${1:-}"

if ! command -v deskflow >/dev/null 2>&1 && ! command -v deskflow-core >/dev/null 2>&1; then
    exit 0
fi

ensure_wl_clipboard() {
    local file="$1"
    local dir
    dir="$(dirname "$file")"
    mkdir -p "$dir"

    if [[ ! -f "$file" ]]; then
        cat > "$file" <<'EOF'
[core]
wlClipboard=true
EOF
        return 0
    fi

    if grep -q '^wlClipboard=' "$file"; then
        sed -i 's/^wlClipboard=.*/wlClipboard=true/' "$file"
        return 0
    fi

    if grep -q '^\[core\]' "$file"; then
        awk '
            BEGIN { inserted = 0 }
            /^\[core\]/ { print; print "wlClipboard=true"; inserted = 1; next }
            { print }
            END { if (!inserted) { print ""; print "[core]"; print "wlClipboard=true" } }
        ' "$file" > "${file}.tmp"
        mv "${file}.tmp" "$file"
    else
        printf '\n[core]\nwlClipboard=true\n' >> "$file"
    fi
}

# Seed future users and the primary Calamares-created user. Avoid relying on
# /etc/Deskflow/Deskflow.conf because Deskflow may treat the loaded settings
# file as its writable settings path; per-user files are safer for the GUI.
ensure_wl_clipboard /etc/skel/.config/Deskflow/Deskflow.conf

if [[ -n "$user" ]] && id "$user" >/dev/null 2>&1; then
    user_home="$(getent passwd "$user" | cut -d: -f6)"
    if [[ -n "$user_home" && -d "$user_home" ]]; then
        ensure_wl_clipboard "$user_home/.config/Deskflow/Deskflow.conf"
        chown -R "$user:$user" "$user_home/.config/Deskflow"
    fi
fi
